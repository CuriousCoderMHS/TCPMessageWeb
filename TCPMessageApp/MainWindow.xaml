<Window x:Class="TCPMessageApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCP Messaging Studio"
        
        Height="650" Width="760"
        MinHeight="650" MinWidth="760"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#1677FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0F5FC9" />
        <SolidColorBrush x:Key="PanelBrush" Color="White" />
        <SolidColorBrush x:Key="MutedBrush" Color="#607080" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8E0EA" />

        <!-- General text -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#344054"/>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Text boxes -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <!-- Combo boxes -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#102A43">
            <Grid Margin="24,12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App icon -->
                <Grid Width="52" Height="52">
                    <Border Background="#1677FF" CornerRadius="13" />
                    <Line X1="17" Y1="20" X2="36" Y2="16"
                      Stroke="White" StrokeThickness="3" />
                                <Line X1="17" Y1="20" X2="32" Y2="36"
                      Stroke="White" StrokeThickness="3" />
                                <Ellipse Width="11" Height="11" Fill="White"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="10,14,0,0" />
                                <Ellipse Width="11" Height="11" Fill="White"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,10,10,0" />
                                <Ellipse Width="11" Height="11" Fill="White"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,15,10" />
                </Grid>


                <!--Header-->
                <StackPanel Grid.Column="1"
                        Margin="13,0,0,0"
                        VerticalAlignment="Center">
                                <TextBlock Text="TCP Messaging Studio"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White" />
                                <TextBlock Text="HL7 MLLP and ASTM E1381 communication testing"
                           Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="#B9C9DA" />
                </StackPanel>

                <!-- STATUS -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="163,0,0,0">

                    <Ellipse x:Name="StatusElipse"
                             Width="12"
                             Height="12"
                             Fill="#22C55E"
                             Margin="0,0,8,0"/>

                    <StackPanel>

                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Ready"
                                   FontWeight="SemiBold"
                                   Foreground="#16A34A"/>

                        <TextBlock Text="Version 1.0.0"
                                   FontSize="12"
                                   Foreground="#667085"/>

                    </StackPanel>

                </StackPanel>

            </Grid>
        </Border>


                <!-- CONNECTION PANEL -->
        <Border Grid.Row="1"
                Margin="24,16,24,10"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="16">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- MODE -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="Mode"
                               FontWeight="SemiBold"
                               Margin="5,0,0,2"/>

                    <ComboBox x:Name="ModeComboBox"
                              SelectedIndex="0"
                              SelectionChanged="ModeComboBox_SelectionChanged">

                        <ComboBoxItem Content="Client"/>
                        <ComboBoxItem Content="Host"/>

                    </ComboBox>

                </StackPanel>

                <!-- IP / HOST -->
                <StackPanel x:Name="ClientIPSettingsPanel" 
                            Grid.Column="1"
                            Visibility="Visible">

                    <TextBlock Text="Host / IP"
                               FontWeight="SemiBold"
                               Margin="5,0,0,2"/>

                    <TextBox x:Name="HostTextBox"
                             Text="127.0.0.1"/>

                </StackPanel>

                <!-- PORT -->
                <StackPanel x:Name="ClientPortSettingsPanel" 
                            Grid.Column="2"
                            Visibility="Visible">

                    <TextBlock Text="Port"
                               FontWeight="SemiBold"
                               Margin="5,0,0,2"/>

                    <TextBox x:Name="PortTextBox"
                             Text="5000"/>

                </StackPanel>

                <!-- HOST Port -->
                <StackPanel x:Name="HostSettingsPanel"
                            Grid.Column="1"
                            Visibility="Hidden">

                    <TextBlock Text="Host Port"
                                FontWeight="SemiBold"
                                Margin="5,0,0,2"/>

                    <TextBox x:Name="HostPortTextBox"
                            Text="5000"/>

                </StackPanel>

                <!-- MESSAGE FORMAT -->
                <StackPanel Grid.Column="3">

                    <TextBlock Text="Message format"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="5,0,12,0"/>

                    <ComboBox x:Name="ProtocolComboBox"
                              SelectedIndex="0"
                              SelectionChanged="ProtocolComboBox_SelectionChanged">

                        <ComboBoxItem Content="ASTM E1381"/>
                        <ComboBoxItem Content="HL7 v2 / MLLP"/>
                    </ComboBox>

                </StackPanel>

                <!-- Client CONNECT -->
                <StackPanel x:Name="ClientButtonPanel"
                            Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0">

                    <Button x:Name="ConnectButton"
                            Content="Connect"
                            Click="ConnectButton_Click"/>

                    <Button x:Name="DisconnectButton"
                            Content="Disconnect"
                            Background="#667085"
                            Click="DisconnectButton_Click"/>

                </StackPanel>

                <!-- Host CONNECT -->
                <StackPanel x:Name="HostButtonPanel"
                            Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0"
                            Visibility="Hidden">

                    <Button x:Name="HostButton"
                            Content="Start Host"
                            Click="HostButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- COMMUNICATION LOG -->
        <Border Grid.Row="2"
        Margin="24,0,24,10"
        Padding="16"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="9">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196*"/>
                    <ColumnDefinition Width="87*"/>
                    <ColumnDefinition Width="501*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Communication activity"
                                   FontSize="17"
                                   FontWeight="SemiBold" Grid.ColumnSpan="4" Margin="0,0,222,113" Grid.RowSpan="2"/>

                <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">

                    <Button Grid.Column="1"
                                    Content="Export log"
                                    Background="#667085"
                                    Click="ExportLogButton_Click"/>

                    <Button Grid.Column="1"
                                    Content="Clear log"
                                    Background="#667085"
                                    Click="ClearLogButton_Click"/>

                </StackPanel>

                <TextBox Grid.Row="1"
                                 Grid.ColumnSpan="4"
                                 x:Name="CommunicationLogTextBox"
                                 Margin="0,12,0,0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="#FBFCFD"/>

            </Grid>
        </Border>


        <!-- OUTGOING MESSAGE -->
        <Border Grid.Row ="3"
                Margin="24,0,24,10"
                Padding="14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="105" />
                </Grid.ColumnDefinitions>

                <!-- OUTGOING MESSAGE LABEL -->
                <Grid Grid.Column = "0"
                        Margin="0,16,0,8">

                    <StackPanel>
                        <TextBlock Text="Outgoing message"
                                    FontSize="17"
                                    FontWeight="SemiBold"/>

                        <TextBox x:Name="OutgoingMessageTextBox"
                                 Height="72"
                                 Margin="0,7,0,0"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                FontFamily="Consolas"
                                FontSize="12"
                                Background="#FBFCFD"/>
                    </StackPanel>
                </Grid>


                <!-- OUTGOING MESSAGE -->
                <Button x:Name="BuildMessageButton"
                        Grid.Column ="1"
                        Content="Build ASTM"
                        Margin="14,25,0,0"
                        Height="42"
                        Background="#667085"
                        Click="BuildMessage_Click"/>

                <Button Content="Send"
                        Grid.Column ="2"
                        Margin="14,25,0,0"
                        Height="42"
                        x:Name="SendButton"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>


            <!-- FOOTER -->
        <Grid Grid.Row="4">

            <TextBlock Text="TCP Messaging Studio. Approved for Test Environments Only"
                       Foreground="#98A2B3"
                       VerticalAlignment="Center"/>

            <TextBlock Text="ASTM E1381 • HL7 MLLP"
                       HorizontalAlignment="Right"
                       Foreground="#98A2B3"
                       VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</Window>
