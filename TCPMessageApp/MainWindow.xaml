<Window x:Class="TCPMessageApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCP Messaging Studio"
        Width="1100"
        Height="750"
        MinWidth="900"
        MinHeight="650"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- General text -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#344054"/>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Text boxes -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Combo boxes -->
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">

                <!-- App icon -->
                <Border Width="58"
                        Height="58"
                        CornerRadius="14"
                        Background="#2563EB"
                        Margin="0,0,16,0">

                    <TextBlock Text="↔"
                               FontSize="32"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="TCP Messaging Studio"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="#1D2939"/>

                    <TextBlock Text="HL7 MLLP and ASTM E1381 communication testing"
                               FontSize="14"
                               Foreground="#667085"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </StackPanel>

            <!-- STATUS -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Ellipse Width="12"
                         Height="12"
                         Fill="#22C55E"
                         Margin="0,0,8,0"/>

                <StackPanel>

                    <TextBlock Text="Ready"
                               FontWeight="SemiBold"
                               Foreground="#16A34A"/>

                    <TextBlock Text="Version 1.0.0"
                               FontSize="12"
                               Foreground="#667085"/>

                </StackPanel>

            </StackPanel>

        </Grid>


        <!-- CONNECTION PANEL -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E4E7EC"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- MODE -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="Mode"
                               FontWeight="SemiBold"
                               Margin="5,0,0,2"/>

                    <ComboBox x:Name="ModeComboBox"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Client"/>
                        <ComboBoxItem Content="Host"/>

                    </ComboBox>

                </StackPanel>

                <!-- IP / HOST -->
                <StackPanel Grid.Column="1">

                    <TextBlock Text="Host / IP"
                               FontWeight="SemiBold"
                               Margin="5,0,0,2"/>

                    <TextBox x:Name="HostTextBox"
                             Text="127.0.0.1"/>

                </StackPanel>

                <!-- PORT -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="Port"
                               FontWeight="SemiBold"
                               Margin="5,0,0,2"/>

                    <TextBox x:Name="PortTextBox"
                             Text="5000"/>

                </StackPanel>

                <!-- CONNECT -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0">

                    <Button x:Name="ConnectButton"
                            Content="Connect"
                            Click="ConnectButton_Click"/>

                    <Button x:Name="DisconnectButton"
                            Content="Disconnect"
                            Background="#667085"
                            Click="DisconnectButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2"
              Margin="0,18,0,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- MESSAGE FORMAT -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Message format"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="5,0,12,0"/>

                <ComboBox Grid.Column="1"
                          x:Name="ProtocolComboBox"
                          SelectedIndex="0">

                    <ComboBoxItem Content="ASTM E1381"/>
                    <ComboBoxItem Content="HL7 v2 / MLLP"/>

                </ComboBox>

            </Grid>


            <!-- COMMUNICATION LOG -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Communication activity"
                               FontSize="17"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="1"
                            Content="Clear log"
                            Background="#667085"
                            Click="ClearLogButton_Click"/>

                    <TextBox Grid.Row="1"
                             Grid.ColumnSpan="2"
                             x:Name="CommunicationLogTextBox"
                             Margin="0,12,0,0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="#FBFCFD"/>

                </Grid>

            </Border>


            <!-- OUTGOING MESSAGE LABEL -->
            <Grid Grid.Row="2"
                  Margin="0,16,0,8">

                <TextBlock Text="Outgoing message"
                           FontSize="17"
                           FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Build ASTM"
                            Background="#667085"
                            Click="BuildAstmButton_Click"/>

                    <Button Content="Send"
                            x:Name="SendButton"
                            Click="SendButton_Click"/>

                </StackPanel>

            </Grid>


            <!-- OUTGOING MESSAGE -->
            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <TextBox x:Name="OutgoingMessageTextBox"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="13"
                         Background="#FBFCFD"/>

            </Border>

        </Grid>


        <!-- FOOTER -->
        <Grid Grid.Row="3">

            <TextBlock Text="TCP Messaging Studio"
                       Foreground="#98A2B3"
                       VerticalAlignment="Center"/>

            <TextBlock Text="ASTM E1381 • HL7 MLLP"
                       HorizontalAlignment="Right"
                       Foreground="#98A2B3"
                       VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</Window>
